# ──────────────────────────────────────────────
# OpenSourceLens — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# GitHub API — required for data collection (Phase 1)
GITHUB_TOKEN=your_github_personal_access_token_here

# PostgreSQL — required for backend (Phase 9+)
# DATABASE_URL=postgresql://user:password@localhost:5432/opensourcelens
