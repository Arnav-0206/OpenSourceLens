# ──────────────────────────────────────────────
# OpenSourceLens — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ─── GitHub API ────────────────────────────────
# Required for data collection and issue harvesting (Phase 1)
GITHUB_TOKEN=your_github_personal_access_token_here

# ─── Database Configuration ─────────────────────
# PostgreSQL production database configuration (Phase 9+):
DATABASE_URL=postgresql://opensourcelens:lens_password_secure@localhost:5432/opensource_lens

# Alternative SQLite fallback for local development or testing:
# DATABASE_URL=sqlite:///data/opensource_lens.db

# ─── FastAPI Backend ────────────────────────────
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
PREWARM_ON_STARTUP=false

# ─── Next.js Frontend ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
