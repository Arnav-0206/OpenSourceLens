# ──────────────────────────────────────────────
# OpenSourceLens — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# GitHub API — required for data collection (Phase 1)
GITHUB_TOKEN=your_github_personal_access_token_here

# PostgreSQL — production database configuration (Phase 9+)
# When using docker-compose.yml:
DATABASE_URL=postgresql://opensourcelens:lens_password_secure@localhost:5432/opensource_lens

# Alternative SQLite fallback for local development or testing:
# DATABASE_URL=sqlite:///data/opensource_lens.db

