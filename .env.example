# ──────────────────────────────────────────────
# OpenSourceLens — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ─── GitHub API ────────────────────────────────
# Required for dynamic data collection, eligibility checks, and issue/PR harvesting.
# Personal Access Token (classic or fine-grained) with public_repo scope.
GITHUB_TOKEN=your_github_personal_access_token_here

# ─── Database Configuration ─────────────────────
# PostgreSQL production database configuration (Docker / hosted Postgres):
DATABASE_URL=postgresql://opensourcelens:lens_password_secure@localhost:5432/opensource_lens

# Alternative SQLite fallback for local development or testing:
# DATABASE_URL=sqlite:///data/opensource_lens.db

# ─── FastAPI Backend ────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
PREWARM_ON_STARTUP=false

# ─── Background Workers ─────────────────────────
# When set to true, the FastAPI server will run embedded async worker loops inside lifespan.
# Set to false when running workers as dedicated standalone CLI processes.
ENABLE_INGESTION_WORKER=false
INGESTION_WORKER_POLL_INTERVAL_SECONDS=5.0

ENABLE_ANALYTICS_WORKER=false
ANALYTICS_WORKER_POLL_INTERVAL_SECONDS=5.0
ANALYTICS_WORKER_RECONCILE_INTERVAL_SECONDS=60.0

# ─── Testing & Live Validation ──────────────────
# Set to 1 or true to enable live test execution against real GitHub repositories.
# RUN_LIVE_GITHUB_TESTS=1

# ─── Next.js Frontend ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
